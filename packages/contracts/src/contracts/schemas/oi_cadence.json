{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument_id", "window_s", "oi_updates", "sources"],
  "properties": {
    "instrument_id": {"type": "string"},
    "window_s": {"type": "integer"},
    "oi_updates": {"type": "integer"},
    "median_gap_s": {"type": ["number", "null"]},
    "p90_gap_s": {"type": ["number", "null"]},
    "last_oi_change": {"type": ["string", "null"], "format": "date-time"},
    "sources": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
