# Secrets and local env — never commit
secrets/
.env
.env.*
!.env.example

# Local workspace overlay (may contain secrets if someone puts keys there)
config/workspace.local.yaml
config/local.yaml
# Private C5-01 customer overlay (copy of customers.example.yaml). No secrets.
config/v2/accounts/customers.yaml

# Data payloads (catalogs, transcripts); keep folder placeholders
data/youtube/**
!data/youtube/.gitkeep
data/transcripts/**
!data/transcripts/.gitkeep
data/topics/**
!data/topics/.gitkeep
data/desk_intel/**
!data/desk_intel/.gitkeep
data/recon/**
!data/recon/.gitkeep
!data/recon/ml/
!data/recon/ml/.gitkeep
# Trade ledger (orders, fills, P&L) and health alerts — never commit
data/ledger/
data/health/
# LLM analyst call log (PR-016)
data/llm_analyst/
# Shadow decision logs. The engine creates data/shadow/ at runtime. Do not commit rows.
data/shadow/
# C5-04 paper customer books (never commit ledgers / backups)
data/c5/
data/c5-backups/
# V2 market-data tapes (depth, quotes, OI cadence, raw frames) and the scrip-master cache
data/tape/
data/cache/

# Live-rewritten founder board (open in Cursor / browser; do not commit ticks)
teams/00_orchestrator/canvases/*
!teams/00_orchestrator/canvases/README.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
.venv-v2/
venv/

# Node
node_modules/

# OS / editor
.DS_Store

# Nested package venvs
packages/*/.venv/
**/.venv/

# Large local caches / whisper
*.pt
*.bin
data/asr_cache/

# Knowledge DB WAL sidecars (commit the .sqlite when useful)
# The trading_agents_india KB holds captured sessions, tickets and tape snippets: never public.
data/knowledge/trading_agents_india.sqlite
data/knowledge/*.sqlite-wal
data/knowledge/*.sqlite-shm
data/knowledge/warehouse.sqlite
data/knowledge/RECLAIM_REPORT.json

# EXTERNAL shallow clone (re-clone via ADOPT_TRADINGAGENTS.md); nested .git
research/TradingAgents/

# Build / ASR audio (reinstallable / regenerable)
apps/web/dist/
*.m4a
data/**/audio/*.m4a

# Tool caches inside repo
.cache/
**/yt-dlp-cache/
**/.huggingface/

# Purchased / founder book PDFs — notes only in git (copyright)
teams/01_research/**/*.pdf

