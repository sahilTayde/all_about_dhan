<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac template (PAPER only). Replace REPO with the checkout path, then:
       cp deploy/launchd/com.allaboutdhan.paper-loop.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.allaboutdhan.paper-loop.plist
     launchd starts the supervisor Mon-Fri at 09:30 (Mac clock in IST; dual-tape refuses to start earlier). health.supervise restarts a
     crashed loop (capped, with backoff) and kills+restarts a hung one; a closed market (exit 2) or
     the founder stop flag ends it cleanly. No KeepAlive: a supervisor that gave up must not be
     respawned all evening. No broker credentials are read here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.allaboutdhan.paper-loop</string>
  <key>WorkingDirectory</key><string>REPO</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO/.venv/bin/python</string><string>-u</string><string>-m</string><string>health.supervise</string>
    <string>--</string>
    <string>REPO/.venv/bin/python</string><string>-u</string><string>-m</string><string>trading_agents_india</string>
    <string>dual-tape</string><string>--live-chain</string><string>--paper-train</string><string>--paper-scalp</string>
    <string>--tick-seconds</string><string>2</string><string>--max-ticks</string><string>0</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>REPO/data/recon/dual_tape_live_2s.log</string>
  <key>StandardErrorPath</key><string>REPO/data/recon/dual_tape_live_2s.log</string>
</dict>
</plist>
