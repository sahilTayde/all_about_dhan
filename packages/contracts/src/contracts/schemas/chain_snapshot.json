{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["underlying", "expiry", "spot", "strikes"],
  "properties": {
    "underlying": {"type": "string"},
    "expiry": {"type": "string"},
    "spot": {"type": "number"},
    "strikes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strike", "ce", "pe"],
        "properties": {
          "strike": {"type": "number"},
          "ce": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ltp": {"type": ["number", "null"]},
              "bid": {"type": ["number", "null"]},
              "ask": {"type": ["number", "null"]},
              "oi": {"type": ["integer", "null"]},
              "oi_chg": {"type": ["integer", "null"]},
              "iv": {"type": ["number", "null"]},
              "volume": {"type": ["integer", "null"]}
            }
          },
          "pe": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ltp": {"type": ["number", "null"]},
              "bid": {"type": ["number", "null"]},
              "ask": {"type": ["number", "null"]},
              "oi": {"type": ["integer", "null"]},
              "oi_chg": {"type": ["integer", "null"]},
              "iv": {"type": ["number", "null"]},
              "volume": {"type": ["integer", "null"]}
            }
          }
        }
      }
    }
  }
}
