{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument_id", "tf", "start", "end", "o", "h", "l", "c", "v", "n_ticks"],
  "properties": {
    "instrument_id": {"type": "string"},
    "tf": {"type": "string", "enum": ["1m", "3m", "5m"]},
    "start": {"type": "string", "format": "date-time"},
    "end": {"type": "string", "format": "date-time"},
    "o": {"type": ["number", "null"]},
    "h": {"type": ["number", "null"]},
    "l": {"type": ["number", "null"]},
    "c": {"type": ["number", "null"]},
    "v": {"type": ["integer", "null"]},
    "n_ticks": {"type": "integer"},
    "gap": {"type": "boolean"},
    "late_ticks": {"type": "integer"}
  }
}
