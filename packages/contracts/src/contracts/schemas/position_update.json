{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["position_id", "account_id", "instrument_id", "net_qty", "avg_price", "mark", "unrealized_inr", "stop", "strategy_id"],
  "properties": {
    "position_id": {"type": "string"},
    "account_id": {"type": "string"},
    "instrument_id": {"type": "string"},
    "net_qty": {"type": "integer"},
    "avg_price": {"type": "number"},
    "mark": {"type": "number"},
    "unrealized_inr": {"type": "number"},
    "stop": {"type": "object"},
    "protective_order": {"type": ["string", "null"]},
    "strategy_id": {"type": "string"}
  }
}
