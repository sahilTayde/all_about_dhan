{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_order_id", "broker_order_id", "account_id", "from", "to", "reason", "purpose"],
  "properties": {
    "client_order_id": {"type": "string"},
    "broker_order_id": {"type": "string"},
    "account_id": {"type": "string"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "reason": {"type": "string"},
    "purpose": {"type": "string", "enum": ["ENTRY", "STOP", "EXIT"]}
  }
}
