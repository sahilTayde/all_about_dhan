# Optional. Leave empty to load public/mock/signal.json (no network, no Dhan).
# Later, point at the FastAPI app, e.g. http://127.0.0.1:8000
# Customer `/` tries GET /v2/snapshot?channels=signals:public then MOCK.
VITE_API_URL=
# Customer JWT only (packages/auth role=customer). Never a founder token.
VITE_CUSTOMER_JWT=
