{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["catastrophic"],
  "properties": {
    "catastrophic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "price"],
          "properties": {
            "kind": {"type": "string", "enum": ["premium", "underlying"]},
            "price": {"type": "number"}
          }
        }
      }
    },
    "structural": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "price"],
          "properties": {
            "kind": {"type": "string", "enum": ["premium", "underlying"]},
            "price": {"type": "number"}
          }
        },
        "trigger": {"type": "string", "enum": ["bar_close", "tick"]}
      }
    },
    "atr": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["k"],
      "properties": {
        "k": {"type": "number"},
        "trigger": {"type": "string", "enum": ["bar_close", "tick"]}
      }
    },
    "time_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["after_s"],
        "properties": {
          "after_s": {"type": "integer"},
          "when": {"type": "string"},
          "unless_profit_pts": {"type": ["number", "null"]}
        }
      }
    },
    "grace": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["seconds"],
      "properties": {
        "seconds": {"type": "integer"}
      }
    },
    "signal_flip": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "array",
          "items": {"type": "string"}
        },
        "trigger": {"type": "string", "enum": ["bar_close", "tick"]}
      }
    },
    "target": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "price"],
      "properties": {
        "kind": {"type": "string", "enum": ["premium", "underlying"]},
        "price": {"type": "number"}
      }
    },
    "partials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "fraction"],
        "properties": {
          "at": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "price"],
            "properties": {
              "kind": {"type": "string", "enum": ["premium", "underlying"]},
              "price": {"type": "number"}
            }
          },
          "fraction": {"type": "number"}
        }
      }
    },
    "trail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "activate_at"],
      "properties": {
        "kind": {"type": "string", "enum": ["step", "percent"]},
        "activate_at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "price"],
          "properties": {
            "kind": {"type": "string", "enum": ["premium", "underlying"]},
            "price": {"type": "number"}
          }
        },
        "step": {"type": ["number", "null"]},
        "percent": {"type": ["number", "null"]}
      }
    },
    "flat_by_ist": {"type": "string"},
    "defaults_from": {"type": ["string", "null"]}
  }
}
