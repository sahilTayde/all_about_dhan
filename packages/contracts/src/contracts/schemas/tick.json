{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument_id", "ltp", "ltq", "volume", "oi", "exchange_ts"],
  "properties": {
    "instrument_id": {"type": "string"},
    "ltp": {"type": ["number", "null"]},
    "ltq": {"type": ["integer", "null"]},
    "volume": {"type": ["integer", "null"]},
    "oi": {"type": ["integer", "null"]},
    "exchange_ts": {"type": "string", "format": "date-time"}
  }
}
