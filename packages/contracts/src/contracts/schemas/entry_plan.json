{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "decision_id", "signal_id", "account_id", "action", "shadow_actions", "stretch", "signal_candle_atr", "limit_price", "expires_at", "client_order_id"],
  "properties": {
    "plan_id": {"type": "string"},
    "decision_id": {"type": "string"},
    "signal_id": {"type": "string"},
    "account_id": {"type": "string"},
    "action": {"type": "string", "enum": ["CHASE", "LIMIT", "WAIT"]},
    "shadow_actions": {"type": "array", "items": {"type": "string"}},
    "stretch": {"type": "object"},
    "zone": {"type": ["string", "null"]},
    "zone_price": {"type": ["number", "null"]},
    "entry_distance_atr": {"type": ["number", "null"]},
    "signal_candle_atr": {"type": "number"},
    "limit_price": {"type": "number"},
    "est_delta": {"type": ["number", "null"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "client_order_id": {"type": "string"}
  }
}
