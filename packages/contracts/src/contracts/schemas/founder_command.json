{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "account_id", "kind", "args", "actor"],
  "properties": {
    "command_id": {"type": "string"},
    "account_id": {"type": "string"},
    "kind": {"type": "string", "enum": ["CUT_LOSS", "FLATTEN", "KILL", "REARM", "PAUSE", "RESUME"]},
    "args": {"type": "object"},
    "actor": {"type": "string"},
    "reason": {"type": ["string", "null"]},
    "confirm_token": {"type": ["string", "null"]}
  }
}
