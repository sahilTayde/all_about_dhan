# Variable NAMES only. Put real values in .env or secrets/ — never commit them,
# and never paste them into chat or LLM prompts.
#
# URLs, books, news RSS, and which YouTube channel to use: config/workspace.yaml
# (change URLs/books/news there; change keys here). That yaml may list ${YOUTUBE_API_KEY}
# as a reference — the value still lives only in this .env file.

# YouTube Data API v3 — real value goes in repo-root .env only (never git, never chat)
YOUTUBE_API_KEY=

# OpenAI — optional for packages/trading_agents_india LLM agents / frontier review.
# Leave empty for rule-based paper dry-run fallback. Never paste values into chat.
OPENAI_API_KEY=
# Optional model override (default gpt-4o)
OPENAI_MODEL=

# DhanHQ — live REST/WS only (quotes, option chain, feed). Leave empty for dry-run.
# desk_intel morning/poll-chain uses these for live chain; news RSS does not.
# Never paste values into chat.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# VERIFY FROM DOCS: official v2 RenewToken uses the current access-token, not a separate refresh_token field.
DHAN_REFRESH_TOKEN=
# VERIFY FROM DOCS: official individual OAuth uses app_id / app_secret headers, not this name.
DHAN_CLIENT_SECRET=
